---
import Layout from '../layouts/Layout.astro';
---
<Layout title_cy="Tudalen heb ei Darganfod" title_en="Page Not Found">
  <div class="site-wrap">
    <div class="content page-404">
      <h1>404</h1>
      <p lang="cy">Mae'n ddrwg gennym — nid yw'r dudalen hon ar gael.</p>
      <p lang="en">Sorry — this page could not be found.</p>
      <a href="/" class="btn">
        <span lang="cy">Yn ôl i'r Hafan</span>
        <span lang="en">Back to Home</span>
      </a>
    </div>
  </div>
</Layout>
