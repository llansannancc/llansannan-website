---
import Layout from '../../layouts/Layout.astro';
import councillors from '../../data/councillors.json';
---
<Layout title_cy="Proffiliau Wardiau" title_en="Ward Profiles">
  <div class="page-banner"><h1><span lang="cy">Proffiliau Wardiau</span><span lang="en">Ward Profiles</span></h1></div>
  <div class="breadcrumb">
    <a href="/"><span lang="cy">Hafan</span><span lang="en">Home</span></a> &rsaquo;
    <a href="/councillors/"><span lang="cy">Cynghorwyr</span><span lang="en">Councillors</span></a> &rsaquo;
    <span lang="cy">Proffiliau Wardiau</span><span lang="en">Ward Profiles</span>
  </div>
  <div class="site-wrap"><div class="content" data-pagefind-body>
    <h2 class="sh"><span lang="cy">Proffiliau'r Wardiau</span><span lang="en">Ward Profiles</span></h2><hr class="sh-rule">

    <p lang="cy">Mae Cyngor Cymuned Llansannan yn cwmpasu tair ward etholiadol. Dyma grynodeb o bob ward.</p>
    <p lang="en">Llansannan Community Council covers three electoral wards. Here is a summary of each ward.</p>

    {councillors.wards.map(ward => {
      const active = ward.councillors.filter(c => c.active);
      const vacancies = ward.councillors.filter(c => !c.active);
      return (
        <div style="border:1px solid var(--border);border-radius:6px;padding:1.25rem;margin-bottom:1.5rem">
          <h3><span lang="cy">{ward.name_cy}</span><span lang="en">{ward.name_en}</span></h3>
          <p lang="cy"><strong>Seddau:</strong> {ward.councillors.length} &nbsp;|&nbsp; <strong>Yn eistedd:</strong> {active.length}{vacancies.length > 0 ? ` | Swyddi gwag: ${vacancies.length}` : ''}</p>
          <p lang="en"><strong>Seats:</strong> {ward.councillors.length} &nbsp;|&nbsp; <strong>Sitting:</strong> {active.length}{vacancies.length > 0 ? ` | Vacancies: ${vacancies.length}` : ''}</p>
          <ul>
            {active.map(c => (
              <li>
                {c.name}
                {c.role_en && c.role_en !== 'Councillor' && <> — <em><span lang="cy">{c.role_cy}</span><span lang="en">{c.role_en}</span></em></>}
              </li>
            ))}
            {vacancies.map(() => (
              <li style="color:var(--text-muted);font-style:italic">
                <span lang="cy">Sedd wag — ar gael i ymgeisio</span>
                <span lang="en">Vacant seat — available for co-option</span>
              </li>
            ))}
          </ul>
        </div>
      );
    })}

    <p><a href="/councillors/ward-map/"><span lang="cy">Gweld y map ward →</span><span lang="en">View ward map →</span></a></p>
  </div></div>
</Layout>
